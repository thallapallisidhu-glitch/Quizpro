rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Users: create/read own profile; admins can read all and remove students
    match /users/{uid} {
      allow create: if signedIn() && request.auth.uid == uid
                    && request.resource.data.role in ['admin', 'student'];
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow update: if signedIn() && request.auth.uid == uid
                    && request.resource.data.role == resource.data.role;
      allow delete: if isAdmin();
    }

    // Quizzes: students see published only; admins manage everything
    match /quizzes/{id} {
      allow read: if signedIn() && (resource.data.published == true || isAdmin());
      allow write: if isAdmin();
    }

    // Questions: any signed-in user may read; only admins write
    match /questions/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // Results: students create their own; everyone signed in can read (leaderboard)
    match /results/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }
  }
}
